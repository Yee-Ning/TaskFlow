{
  "name": "taskflow",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "TaskFlow 本地任务管理与提醒桌面应用",
  "license": "MIT",
  "private": true,
  "author": "Yee-Ning",
  "homepage": "https://github.com/Yee-Ning/TaskFlow",
  "repository": { "type": "git", "url": "https://github.com/Yee-Ning/TaskFlow.git" },
  "engines": { "node": ">=22 <23" },
  "keywords": [
    "electron",
    "vue",
    "task-management",
    "offline",
    "sqlite"
  ],
  "scripts": {
    "dev": "vite",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "smoke:win": "node scripts/smoke.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.2",
    "fast-check": "^4.5.3",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.44",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0",
    "vue-tsc": "^2.0.6"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "exceljs": "^4.4.0"
  }
}
